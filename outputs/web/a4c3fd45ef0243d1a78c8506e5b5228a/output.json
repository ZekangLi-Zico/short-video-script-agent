    "available_facts": [
      {
        "source_id": "CZ-WORLD",
        "fact_id": "CZ-WORLD.F1",
        "quote": "进入城寨时，打至第七擂、获得任意《古小说钩沉》录本残片、唤醒姑获鸟，是三个可任选其一的事件开启条件。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-WORLD",
        "fact_id": "CZ-WORLD.F2",
        "quote": "城寨这次最长停留一个月；一旦输掉拳赛即刻回归。一个月是试炼停留上限，不是医生宣布陈峥只剩一个月寿命。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-WORLD",
        "fact_id": "CZ-WORLD.F3",
        "quote": "确认港币拥有权后，10000港币可兑换1点阎浮点数。ES造血细胞增强剂为10点，能缓解症状；补完剂为300点，对应治病目标，折合三百万港币。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-WORLD",
        "fact_id": "CZ-WORLD.F4",
        "quote": "陈峥争取尽快赚够三百万是自己的目标，原设定给他三次阎浮事件筹齐点数的机会，并非系统要求这一个月必须赚够三百万。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-WORLD",
        "fact_id": "CZ-WORLD.F5",
        "quote": "取得两张残片后，事件已开启，目标是唤醒姑获鸟。失败扣除本事件全部点数并抹除本事件开启的购买权限，不抹杀本人。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-WORLD",
        "fact_id": "CZ-WORLD.F6",
        "quote": "残片会提供位置通报；人物需要结合多次通报调查。它不是全天开启的精准导航，也没有必须集齐五张才能行动的既定规则。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-WORLD",
        "fact_id": "CZ-WORLD.F7",
        "quote": "惊鸿一瞥是主动消耗点数获取信息的能力，不保证立即发现弱点；敌意红光是另一提示。二者都不是时间停止。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-WORLD",
        "fact_id": "CZ-WORLD.F8",
        "quote": "系统信息是相应行走的主观信息。赤锋、薇娜、警方没有被告知阎浮规则，不能因为站在旁边就看到或听到系统。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E01",
        "fact_id": "CZ-E01.F1",
        "quote": "梁宁到旧音像店邀请陈峥去广东做协会顾问；陈峥出示病情化验单，婉拒邀请。来访谈及梁振山，陈峥回忆他对自己“三分恶气”的评价。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E01",
        "fact_id": "CZ-E01.F2",
        "quote": "梁宁和真正的杜叔离开后，貘借杜叔外形试探陈峥。陈峥识破异样，在病体中应对，随后主动接受去阎浮试炼的机会。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E01",
        "fact_id": "CZ-E01.F3",
        "quote": "陈峥来到1986年九龙城寨的地下拳台，击败巴颂。主持人确认陈峥获胜，他随即挑战下一人；本集不止于登上擂台。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E01",
        "fact_id": "CZ-E01.F4",
        "quote": "陈峥的求生欲从音像店里的疲惫沉静转为拳台上的主动争取；真正杜叔未受到伤害。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E02",
        "fact_id": "CZ-E02.F1",
        "quote": "韩振涛奉花衫七之意试探陈峥，短暂交手被叫停，未分正式胜负；赤锋介入，与陈峥建立拳手和经理人的关系。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E02",
        "fact_id": "CZ-E02.F2",
        "quote": "陈峥将五万港币确认为己有，兑换到5点，计算出300点补完剂需要三百万港币；赤锋告诉他晋级越高奖金越多。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E02",
        "fact_id": "CZ-E02.F3",
        "quote": "陈峥认识贫民女孩阿晴，看到她照料橘猫阿咪，表现出对弱小生命的关心。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E02",
        "fact_id": "CZ-E02.F4",
        "quote": "陈峥连胜后，由赤锋带往福义大厦，得知下一场第六擂对手是黑川隼。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E03",
        "fact_id": "CZ-E03.F1",
        "quote": "薇娜在福义大厦观看陈峥对黑川隼的拳赛，最初怀疑苍白病弱的陈峥，随后因他的表现产生兴趣。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E03",
        "fact_id": "CZ-E03.F2",
        "quote": "陈峥利用步法避开黑川隼的关节技，再用鸣鹤拳破坏对方进攻节奏并获胜；战后陈峥仍明显疲惫，疾病没有消失。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E03",
        "fact_id": "CZ-E03.F3",
        "quote": "方绍钧与赵仲衡讨论丰宝银行劫案：四名劫匪抢走现金、珠宝和一本《古小说钩沉》录本。银行经理死于城寨，相关关系尚待调查。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E03",
        "fact_id": "CZ-E03.F4",
        "quote": "本集把拳台扬名和古书失窃两条线并置；陈峥尚不知道警方掌握的全部线索。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E04",
        "fact_id": "CZ-E04.F1",
        "quote": "火锅摊上，阿晴因泼汤受到鼻环男刁难；陈峥及时替她解围，赤锋压住其余人的挑衅，陈峥事后仍受病弱影响。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E04",
        "fact_id": "CZ-E04.F2",
        "quote": "陈峥在楼道遇见河北同乡贺振坤，因熟悉的乡音放松警惕，两人原本自然交谈。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E04",
        "fact_id": "CZ-E04.F3",
        "quote": "赤锋打来电话，声音过大，揭出贺振坤是劫匪的身份，被贺振坤听见；不是陈峥故意开免提暴露他。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E04",
        "fact_id": "CZ-E04.F4",
        "quote": "贺振坤以枪挟持陈峥。阿晴路过时，陈峥借口让她去街口买糖，将她支离危险区域，然后独自面对困局。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E05",
        "fact_id": "CZ-E05.F1",
        "quote": "贺振坤把陈峥押进潘叔医馆。劫匪共四人：贺振坤、郭劲、小伍和一名未具名同伙；潘叔是医生，陈峥是被劫持者。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E05",
        "fact_id": "CZ-E05.F2",
        "quote": "潘叔事先报警，引来警方围捕；贺振坤随后发现告密并对潘叔下手。劫匪是否带走重伤小伍的争执形成脱困机会。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E05",
        "fact_id": "CZ-E05.F3",
        "quote": "陈峥使用惊鸿一瞥获得有限信息，在混乱中挣脱束缚，用手术刀反制郭劲并与贺振坤周旋；不是持枪互射。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E05",
        "fact_id": "CZ-E05.F4",
        "quote": "陈峥反击脱困后，警方破门控制现场并要求他配合。前六集承接时已取得两张古书残片、事件进行中；局部第六集不重复演出开启。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E06",
        "fact_id": "CZ-E06.F1",
        "quote": "警局里，方绍钧追问医馆经过和失窃古书。陈峥说明自己遭挟持、趁内讧脱身，保持求生立场；探长可以怀疑，未直接证明其主观动机。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E06",
        "fact_id": "CZ-E06.F2",
        "quote": "保释后，薇娜与陈峥吃饭：薇娜支付保释金，天魁提供帮助。薇娜视他为投资，陈峥回应“我比谁都想活着赢”。两人是互相试探，尚非确认的情侣。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E06",
        "fact_id": "CZ-E06.F3",
        "quote": "陈峥向薇娜打听收旧书和老物件的门路，薇娜避开问题。随后他用典当传家宝的借口向花衫七、小韩问路。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E06",
        "fact_id": "CZ-E06.F4",
        "quote": "小韩建议去利兴大押，并与陈峥再次约战。利兴大押是问出的交易渠道，不是系统直接给出的精确藏片地点。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-E06",
        "fact_id": "CZ-E06.F5",
        "quote": "结尾赤锋看徐承岳资料：徐承岳是咏春徐尚田之孙。徐只以静态档案照片出现，尚未与陈峥正面对战。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-C-CHEN",
        "fact_id": "CZ-C-CHEN.F1",
        "quote": "陈峥曾是国术高手，现因白血病身体虚弱，现实线经营旧音像店；进入城寨的核心动机是活下去，不是征服城寨。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-C-CHEN",
        "fact_id": "CZ-C-CHEN.F2",
        "quote": "陈峥做事冷静、机敏、果断，话少而有对象，带自嘲和人情味；他保护阿晴，也关心小韩，不能只写成逞狠的拳手。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-C-CHEN",
        "fact_id": "CZ-C-CHEN.F3",
        "quote": "前六集病弱持续影响体力；第七集增强剂暂缓症状；第八集与顾明川对决后右臂暂时失力，随后护送中仍受影响。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-C-CHEN",
        "fact_id": "CZ-C-CHEN.F4",
        "quote": "陈峥可以有内心旁白；人物不张口的心声、正常对白和只有他感知的系统信息在表现上分开。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-C-QING",
        "fact_id": "CZ-C-QING.F1",
        "quote": "阿晴是住在陈峥附近的贫民女孩，照料橘猫阿咪。陈峥曾替她解围，并在遭劫持时支她去买糖，让她离开危险。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-C-QING",
        "fact_id": "CZ-C-QING.F2",
        "quote": "第八集阿晴替母亲送叉烧饭，陈峥在自己家门口接过；饭盒随后仍由陈峥拿着。阿晴母亲只被提及，未在这段出场。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-C-QING",
        "fact_id": "CZ-C-QING.F3",
        "quote": "阿晴家以蜡烛照明，她说电路坏了很久，却迅速拒绝陈峥帮忙。她随后平常地道别；异常是拒绝修电路，资料未揭晓屋内真相。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-PROPS",
        "fact_id": "CZ-PROPS.F1",
        "quote": "拦面叟是顾明川使用的约90厘米烟杆形短兵器；八面汉剑是陈峥借来的约一米三长剑，是两件不同道具。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-PROPS",
        "fact_id": "CZ-PROPS.F2",
        "quote": "第七集武三郎右手持拦面叟，左手摘下面具并放在台面，然后空出的左手才可触胸。面具和斗篷是同一角色的服饰状态。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-PROPS",
        "fact_id": "CZ-PROPS.F3",
        "quote": "第八集陈峥右臂失力后，先空手反击，再左手夺剑；要抓人必须先放下剑，离台前左手取回剑。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-PROPS",
        "fact_id": "CZ-PROPS.F4",
        "quote": "送饭时饭盒从阿晴交给陈峥后保持在他手中；第十集手机先交徐承岳暂拿，再由陈峥左手接回。",
        "version": "2026-11-06-v1"
      },
      {
        "source_id": "CZ-PROPS",
        "fact_id": "CZ-PROPS.F5",
        "quote": "残片是《古小说钩沉》录本的纸页；第六集承接中已取得两张，第九集再得顾明川交出的夔牛残片。没有新增自动隐身或收入系统空间的设定。",
        "version": "2026-11-06-v1"
      }
    ],
