    "title": "阿晴送来的叉烧饭",
    "shots": [
      {
        "purpose": "陈峥刚回住处，阿晴送来母亲准备的饭。",
        "visual": "夜晚，同一条楼道。陈峥刚走到自家门口，阿晴捧着饭盒迎过来。",
        "hold_seconds": 0,
        "blocks": [
          {
            "text": "回来啦？我妈让我给你送份叉烧饭。",
            "source_id": "CZ-E08",
            "fact_id": "CZ-E08.F3",
            "channel": "voice",
            "beat": 1,
            "display_seconds": 0,
            "speaker": "阿晴"
          },
          {
            "text": "正好饿了。替我谢谢阿姨。",
            "source_id": "",
            "fact_id": "",
            "channel": "voice",
            "beat": 2,
            "display_seconds": 0,
            "speaker": "陈峥"
          }
        ],
        "staging": [
          {
            "beat": 1,
            "action": "陈峥在门前停下，转向走来的阿晴。阿晴熟稔地招呼他，把饭盒递到他面前。",
            "camera": "楼道中景，随阿晴走近收成双人景。",
            "sound": "脚步声。",
            "min_seconds": 0
          },
          {
            "beat": 2,
            "action": "陈峥笑着双手接住饭盒；等他托稳，阿晴才松手。陈峥低头看一眼饭盒，再看向她。",
            "camera": "饭盒交接近景，带到陈峥的笑容。",
            "sound": "饭盒轻微摩擦声。",
            "min_seconds": 0
          }
        ]
      },
      {
        "purpose": "关心落在饭盒上，陈峥随后注意到阿晴家的烛光。",
        "visual": "两人仍站在陈峥门口，饭盒由陈峥拿着。阿晴身后的自家门缝透出微弱烛光。",
        "hold_seconds": 0,
        "blocks": [
          {
            "text": "那你趁热吃。",
            "source_id": "",
            "fact_id": "",
            "channel": "voice",
            "beat": 1,
            "display_seconds": 0,
            "speaker": "阿晴"
          },
          {
            "text": "你家怎么还点蜡烛？电路没修好？",
            "source_id": "CZ-E08",
            "fact_id": "CZ-E08.F3",
            "channel": "voice",
            "beat": 2,
            "display_seconds": 0,
            "speaker": "陈峥"
          },
          {
            "text": "嗯，坏了好久了。",
            "source_id": "CZ-E08",
            "fact_id": "CZ-E08.F3",
            "channel": "voice",
            "beat": 3,
            "display_seconds": 0,
            "speaker": "阿晴"
          }
        ],
        "staging": [
          {
            "beat": 1,
            "action": "阿晴看着他手里的饭盒叮嘱一句，侧身准备回家；她身后的门缝进入陈峥视线。",
            "camera": "双人中近景。",
            "sound": "",
            "min_seconds": 0
          },
          {
            "beat": 2,
            "action": "陈峥目光越过阿晴，落到门缝的烛光上，随口问起，再把目光转回她。",
            "camera": "门外拍门缝烛光，切回陈峥。",
            "sound": "",
            "min_seconds": 0
          },
          {
            "beat": 3,
            "action": "阿晴停住脚步，回头应他。陈峥仍托着饭盒，站在原处。",
            "camera": "阿晴近景。",
            "sound": "",
            "min_seconds": 0
          }
        ]
      },
      {
        "purpose": "顺口帮忙遭到过快拒绝，阿晴随即恢复平常语气。",
