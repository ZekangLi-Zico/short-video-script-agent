  "script": {
    "format_version": 2,
    "title": "接手工作室录像：字幕、裁剪和比例怎么安排",
    "shots": [
      {
        "purpose": "明确交接任务，先看懂现有录像",
        "visual": "老运营把交接清单递给实习生；切到现有录像中的产品介绍、操作演示和收尾三个片段，逐一标记对应内容。",
        "hold_seconds": 9,
        "blocks": [
          {
            "text": "接手工作室的录像，先看一遍交接清单，再看素材，弄清这条视频要向观众讲什么。",
            "source_id": "",
            "fact_id": "",
            "channel": "voice",
            "beat": 1,
            "display_seconds": 0
          }
        ]
      },
      {
        "purpose": "根据内容安排字幕重点",
        "visual": "实习生观看产品介绍片段，在纸上记下产品名和交付日期；画面切到对应片段的字幕示意，重点词依次出现。",
        "hold_seconds": 9,
        "blocks": [
          {
            "text": "剪影练习版支持为视频添加字幕。",
            "source_id": "P01",
            "fact_id": "P01.F1",
            "channel": "voice",
            "beat": 1,
            "display_seconds": 0
          },
          {
            "text": "这段介绍里，先记下需要核对的产品名和交付日期。",
            "source_id": "",
            "fact_id": "",
            "channel": "voice",
            "beat": 1,
            "display_seconds": 0
          }
        ]
      },
      {
        "purpose": "核对字幕文字与录像内容",
        "visual": "依次展示交接清单、录像中说到日期的片段、核对后的字幕示意；镜头靠近字幕中的产品名与日期，不展示软件按钮。",
        "hold_seconds": 9,
        "blocks": [
          {
            "text": "字幕文字可以手动编辑。",
            "source_id": "P01",
            "fact_id": "P01.F2",
            "channel": "voice",
            "beat": 1,
            "display_seconds": 0
          },
          {
            "text": "对照交接清单核准这些信息，再跟着录像读一遍，检查有没有写错。",
            "source_id": "",
            "fact_id": "",
            "channel": "voice",
            "beat": 1,
            "display_seconds": 0
          }
        ]
      },
      {
        "purpose": "裁去冗余并保留完整讲解",
        "visual": "用素材缩略图示意开头等待、完整讲解、重复收尾；先圈出冗余段，再播放保留下来的讲解起点与终点，观察句意是否完整。",
        "hold_seconds": 9,
        "blocks": [
          {
            "text": "剪影练习版也支持裁剪视频片段。",
            "source_id": "P02",
            "fact_id": "P02.F1",
            "channel": "voice",
            "beat": 1,
            "display_seconds": 0
          },
          {
            "text": "把开头等待和重复收尾裁掉，保留完整讲解，再听接处是否顺畅。",
            "source_id": "",
            "fact_id": "",
            "channel": "voice",
            "beat": 1,
            "display_seconds": 0
          }
        ]
      },
      {
        "purpose": "根据主体位置判断画面比例",
        "visual": "同一段操作演示依次放入横屏和竖屏示意框；横屏展示人物与桌面，竖屏框突出主体；圈出框边可能被截断的手部动作。",
        "hold_seconds": 9,
        "blocks": [
          {
            "text": "剪影练习版提供横屏和竖屏画面比例选项。",
            "source_id": "P03",
            "fact_id": "P03.F1",
            "channel": "voice",
            "beat": 1,
            "display_seconds": 0
          },
          {
            "text": "选之前，看人物和演示动作能不能完整留在画面里。",
            "source_id": "",
            "fact_id": "",
            "channel": "voice",
            "beat": 1,
            "display_seconds": 0
          }
        ]
      },
      {
        "purpose": "完成连贯检查并交接剪辑理由",
        "visual": "实习生连续观看成片示意，依次核对字幕、片段衔接和主体位置；最后在交接清单上写下保留内容、裁剪位置与比例选择理由。",
        "hold_seconds": 9,
