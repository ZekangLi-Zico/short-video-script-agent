  "materials": [
    {
      "id": "CZ-OVERVIEW",
      "product_id": "city-drama",
      "title": "城寨风云：前十二集故事全貌",
      "version": "2026-11-06-v1",
      "category": "故事与世界观",
      "keywords": [
        "CZ-OVERVIEW",
        "城寨风云：前十二集故事全貌",
        "城寨风云",
        "整体",
        "全篇",
        "总览",
        "预告",
        "宣传片"
      ],
      "facts": [
        {
          "id": "CZ-OVERVIEW.F1",
          "text": "《城寨风云》是本项目对《从姑获鸟开始》九龙城寨篇的改名短剧改编；这份资料覆盖前十二集，前六集对应第1—15章，中篇第七至十二集对应第16—28章。"
        },
        {
          "id": "CZ-OVERVIEW.F2",
          "text": "主角陈峥是一名身患白血病的国术高手。他主动接受貘提供的阎浮试炼机会，进入1986年的九龙城寨，以拳赛挣钱、寻找古书残片，争取治病和活下去的机会。"
        },
        {
          "id": "CZ-OVERVIEW.F3",
          "text": "前六集从病中求生、拳台扬名推进到同乡劫持、医馆脱困和残片任务；中篇从发现另一位行走顾明川，推进到兵器对决、护送徐承岳出城和城寨势力变局。"
        },
        {
          "id": "CZ-OVERVIEW.F4",
          "text": "第十二集只是中篇结束：陈峥仍在寻找残片，尚未唤醒姑获鸟；与徐承岳的最终拳赛、治病成功和回归现实均未发生。"
        },
        {
          "id": "CZ-OVERVIEW.F5",
          "text": "这部故事的核心张力是求生与选择：陈峥既要赢得自己的活路，也会保护阿晴、关心小韩；拳台上的输赢不断牵动台下的人情和利益。"
        }
      ],
      "evidence": [
        {
          "source": "S03",
          "start_line": 51,
          "end_line": 70
        },
        {
          "source": "S04",
          "start_line": 29,
          "end_line": 79
        }
      ]
    },
    {
      "id": "CZ-WORLD",
      "product_id": "city-drama",
      "title": "阎浮、点数与残片规则",
      "version": "2026-11-06-v1",
      "category": "故事与世界观",
      "keywords": [
        "CZ-WORLD",
        "阎浮、点数与残片规则",
        "阎浮",
        "规则",
        "点数",
        "残片",
        "姑获鸟",
        "三百万",
        "一个月",
        "增强剂",
        "补完剂"
      ],
      "facts": [
        {
          "id": "CZ-WORLD.F1",
          "text": "进入城寨时，打至第七擂、获得任意《古小说钩沉》录本残片、唤醒姑获鸟，是三个可任选其一的事件开启条件。"
        },
        {
          "id": "CZ-WORLD.F2",
          "text": "城寨这次最长停留一个月；一旦输掉拳赛即刻回归。一个月是试炼停留上限，不是医生宣布陈峥只剩一个月寿命。"
        },
        {
          "id": "CZ-WORLD.F3",
          "text": "确认港币拥有权后，10000港币可兑换1点阎浮点数。ES造血细胞增强剂为10点，能缓解症状；补完剂为300点，对应治病目标，折合三百万港币。"
        },
        {
          "id": "CZ-WORLD.F4",
          "text": "陈峥争取尽快赚够三百万是自己的目标，原设定给他三次阎浮事件筹齐点数的机会，并非系统要求这一个月必须赚够三百万。"
        },
        {
          "id": "CZ-WORLD.F5",
          "text": "取得两张残片后，事件已开启，目标是唤醒姑获鸟。失败扣除本事件全部点数并抹除本事件开启的购买权限，不抹杀本人。"
        },
        {
          "id": "CZ-WORLD.F6",
          "text": "残片会提供位置通报；人物需要结合多次通报调查。它不是全天开启的精准导航，也没有必须集齐五张才能行动的既定规则。"
        },
        {
          "id": "CZ-WORLD.F7",
          "text": "惊鸿一瞥是主动消耗点数获取信息的能力，不保证立即发现弱点；敌意红光是另一提示。二者都不是时间停止。"
        },
        {
          "id": "CZ-WORLD.F8",
          "text": "系统信息是相应行走的主观信息。赤锋、薇娜、警方没有被告知阎浮规则，不能因为站在旁边就看到或听到系统。"
        }
      ],
      "evidence": [
        {
          "source": "S03",
          "start_line": 10,
          "end_line": 20
        },
        {
          "source": "S04",
          "start_line": 68,
          "end_line": 79
        }
      ]
    },
    {
      "id": "CZ-E01",
      "product_id": "city-drama",
      "title": "第1集·三分恶气",
      "version": "2026-11-06-v1",
      "category": "分集剧情",
      "keywords": [
        "CZ-E01",
        "第1集·三分恶气",
        "第1集",
        "三分恶气",
        "音像店",
        "梁宁",
        "杜叔",
        "貘",
        "巴颂",
        "求生",
        "开篇"
      ],
      "facts": [
        {
          "id": "CZ-E01.F1",
          "text": "梁宁到旧音像店邀请陈峥去广东做协会顾问；陈峥出示病情化验单，婉拒邀请。来访谈及梁振山，陈峥回忆他对自己“三分恶气”的评价。"
        },
        {
          "id": "CZ-E01.F2",
          "text": "梁宁和真正的杜叔离开后，貘借杜叔外形试探陈峥。陈峥识破异样，在病体中应对，随后主动接受去阎浮试炼的机会。"
        },
        {
          "id": "CZ-E01.F3",
          "text": "陈峥来到1986年九龙城寨的地下拳台，击败巴颂。主持人确认陈峥获胜，他随即挑战下一人；本集不止于登上擂台。"
        },
        {
          "id": "CZ-E01.F4",
          "text": "陈峥的求生欲从音像店里的疲惫沉静转为拳台上的主动争取；真正杜叔未受到伤害。"
        }
      ],
      "evidence": [
        {
          "source": "S01",
          "start_line": 1,
          "end_line": 66
        },
        {
          "source": "S03",
          "start_line": 51,
          "end_line": 59
        }
      ]
    },
    {
      "id": "CZ-E02",
      "product_id": "city-drama",
      "title": "第2集·三百万",
      "version": "2026-11-06-v1",
      "category": "分集剧情",
      "keywords": [
        "CZ-E02",
        "第2集·三百万",
        "第2集",
        "三百万",
        "赤锋",
        "韩振涛",
        "小韩",
        "阿晴",
        "阿咪",
        "赚钱",
        "治病"
      ],
      "facts": [
        {
          "id": "CZ-E02.F1",
          "text": "韩振涛奉花衫七之意试探陈峥，短暂交手被叫停，未分正式胜负；赤锋介入，与陈峥建立拳手和经理人的关系。"
        },
        {
          "id": "CZ-E02.F2",
          "text": "陈峥将五万港币确认为己有，兑换到5点，计算出300点补完剂需要三百万港币；赤锋告诉他晋级越高奖金越多。"
        },
        {
          "id": "CZ-E02.F3",
          "text": "陈峥认识贫民女孩阿晴，看到她照料橘猫阿咪，表现出对弱小生命的关心。"
        },
        {
          "id": "CZ-E02.F4",
          "text": "陈峥连胜后，由赤锋带往福义大厦，得知下一场第六擂对手是黑川隼。"
        }
      ],
      "evidence": [
        {
          "source": "S01",
          "start_line": 67,
          "end_line": 122
        },
        {
          "source": "S03",
          "start_line": 51,
