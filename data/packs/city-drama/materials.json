        }
      ]
    },
    {
      "id": "CZ-E03",
      "product_id": "city-drama",
      "title": "第3集·一战扬名",
      "version": "2026-11-06-v1",
      "category": "分集剧情",
      "keywords": [
        "CZ-E03",
        "第3集·一战扬名",
        "第3集",
        "一战扬名",
        "黑川隼",
        "薇娜",
        "方绍钧",
        "古书",
        "丰宝银行"
      ],
      "facts": [
        {
          "id": "CZ-E03.F1",
          "text": "薇娜在福义大厦观看陈峥对黑川隼的拳赛，最初怀疑苍白病弱的陈峥，随后因他的表现产生兴趣。"
        },
        {
          "id": "CZ-E03.F2",
          "text": "陈峥利用步法避开黑川隼的关节技，再用鸣鹤拳破坏对方进攻节奏并获胜；战后陈峥仍明显疲惫，疾病没有消失。"
        },
        {
          "id": "CZ-E03.F3",
          "text": "方绍钧与赵仲衡讨论丰宝银行劫案：四名劫匪抢走现金、珠宝和一本《古小说钩沉》录本。银行经理死于城寨，相关关系尚待调查。"
        },
        {
          "id": "CZ-E03.F4",
          "text": "本集把拳台扬名和古书失窃两条线并置；陈峥尚不知道警方掌握的全部线索。"
        }
      ],
      "evidence": [
        {
          "source": "S01",
          "start_line": 123,
          "end_line": 162
        },
        {
          "source": "S03",
          "start_line": 51,
