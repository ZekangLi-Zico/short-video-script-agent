        }
      ]
    },
    {
      "id": "CZ-E04",
      "product_id": "city-drama",
      "title": "第4集·危险的同乡",
      "version": "2026-11-06-v1",
      "category": "分集剧情",
      "keywords": [
        "CZ-E04",
        "第4集·危险的同乡",
        "第4集",
        "危险的同乡",
        "阿晴",
        "贺振坤",
        "同乡",
        "电话",
        "枪口",
        "火锅"
      ],
      "facts": [
        {
          "id": "CZ-E04.F1",
          "text": "火锅摊上，阿晴因泼汤受到鼻环男刁难；陈峥及时替她解围，赤锋压住其余人的挑衅，陈峥事后仍受病弱影响。"
        },
        {
          "id": "CZ-E04.F2",
          "text": "陈峥在楼道遇见河北同乡贺振坤，因熟悉的乡音放松警惕，两人原本自然交谈。"
        },
        {
          "id": "CZ-E04.F3",
          "text": "赤锋打来电话，声音过大，揭出贺振坤是劫匪的身份，被贺振坤听见；不是陈峥故意开免提暴露他。"
        },
        {
          "id": "CZ-E04.F4",
          "text": "贺振坤以枪挟持陈峥。阿晴路过时，陈峥借口让她去街口买糖，将她支离危险区域，然后独自面对困局。"
        }
      ],
      "evidence": [
        {
          "source": "S01",
          "start_line": 163,
          "end_line": 212
        },
        {
          "source": "S03",
          "start_line": 51,
          "end_line": 59
        }
      ]
    },
    {
      "id": "CZ-E05",
      "product_id": "city-drama",
      "title": "第5集·生死翻盘",
      "version": "2026-11-06-v1",
      "category": "分集剧情",
      "keywords": [
        "CZ-E05",
        "第5集·生死翻盘",
        "第5集",
        "生死翻盘",
        "医馆",
        "潘叔",
        "郭劲",
        "小伍",
        "贺振坤",
        "脱困"
      ],
      "facts": [
        {
          "id": "CZ-E05.F1",
          "text": "贺振坤把陈峥押进潘叔医馆。劫匪共四人：贺振坤、郭劲、小伍和一名未具名同伙；潘叔是医生，陈峥是被劫持者。"
        },
        {
          "id": "CZ-E05.F2",
          "text": "潘叔事先报警，引来警方围捕；贺振坤随后发现告密并对潘叔下手。劫匪是否带走重伤小伍的争执形成脱困机会。"
        },
        {
          "id": "CZ-E05.F3",
          "text": "陈峥使用惊鸿一瞥获得有限信息，在混乱中挣脱束缚，用手术刀反制郭劲并与贺振坤周旋；不是持枪互射。"
        },
        {
          "id": "CZ-E05.F4",
          "text": "陈峥反击脱困后，警方破门控制现场并要求他配合。前六集承接时已取得两张古书残片、事件进行中；局部第六集不重复演出开启。"
        }
      ],
      "evidence": [
        {
          "source": "S01",
          "start_line": 213,
          "end_line": 271
        },
        {
          "source": "S03",
          "start_line": 51,
          "end_line": 59
        }
      ]
    },
    {
      "id": "CZ-E06",
      "product_id": "city-drama",
      "title": "第6集·残篇现踪",
      "version": "2026-11-06-v1",
      "category": "分集剧情",
      "keywords": [
        "CZ-E06",
        "第6集·残篇现踪",
        "第6集",
        "残篇现踪",
        "警局",
        "审讯",
        "薇娜",
        "晚餐",
        "典当",
        "利兴大押",
        "徐承岳"
      ],
      "facts": [
        {
          "id": "CZ-E06.F1",
          "text": "警局里，方绍钧追问医馆经过和失窃古书。陈峥说明自己遭挟持、趁内讧脱身，保持求生立场；探长可以怀疑，未直接证明其主观动机。"
        },
        {
          "id": "CZ-E06.F2",
          "text": "保释后，薇娜与陈峥吃饭：薇娜支付保释金，天魁提供帮助。薇娜视他为投资，陈峥回应“我比谁都想活着赢”。两人是互相试探，尚非确认的情侣。"
        },
        {
          "id": "CZ-E06.F3",
          "text": "陈峥向薇娜打听收旧书和老物件的门路，薇娜避开问题。随后他用典当传家宝的借口向花衫七、小韩问路。"
        },
        {
          "id": "CZ-E06.F4",
          "text": "小韩建议去利兴大押，并与陈峥再次约战。利兴大押是问出的交易渠道，不是系统直接给出的精确藏片地点。"
        },
        {
          "id": "CZ-E06.F5",
          "text": "结尾赤锋看徐承岳资料：徐承岳是咏春徐尚田之孙。徐只以静态档案照片出现，尚未与陈峥正面对战。"
        }
      ],
      "evidence": [
        {
