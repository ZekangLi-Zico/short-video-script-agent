# Offline mode requires no variables. The program reads environment variables;
# this file is documentation and is NOT loaded automatically.
# API mode (Responses by default; use chat for a compatible Chat Completions API):
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_STYLE=responses
# Optional: path to a Codex CLI executable or its npm bin/codex.js entry point.
CODEX_BIN=
# Optional: leave unset to use the installed CLI's configured model.
CODEX_MODEL=
# Per-process reasoning effort for this application; does not change global Codex settings.
CODEX_REASONING_EFFORT=medium
# Built-in OpenAI calls preserve the configured model and service tier but skip
# unrelated user MCP/plugin settings. Custom providers/profiles keep their config.
# Set 1 only when this application must inherit the complete personal config.
CODEX_INHERIT_CONFIG=0
