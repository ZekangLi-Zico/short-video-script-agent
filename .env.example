# Offline mode requires no variables. The program reads environment variables;
# this file is documentation and is NOT loaded automatically.
# API mode (Responses by default; use chat for a compatible Chat Completions API):
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_STYLE=responses
# Optional: path to a Codex CLI executable or its npm bin/codex.js entry point.
CODEX_BIN=
# Optional: leave unset to use the installed CLI's configured model.
CODEX_MODEL=
